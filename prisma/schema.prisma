// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid()) @map("_id") @db.ObjectId
  name        String
  email       String   @unique
  password    String
  phoneNumber String?
  createdAt   DateTime @default(now())
  tickets     Ticket[]
}

model Ticket {
  id                String    @id @default(uuid()) @map("_id") @db.ObjectId
  state             Boolean   @default(true)
  author            User      @relation(fields: [authorId], references: [id])
  currentClass      Class     @relation(fields: [currentClassId], references: [id])
  interestedClasses Class[]   @relation(name: "_InterestedClassToTicket", fields: [interestedClassIds], references: [id])
  subjects          Subject[] @relation(fields: [subjectIds], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  authorId           String   @db.ObjectId
  currentClassId     String   @db.ObjectId
  subjectIds         String[] @db.ObjectId
  interestedClassIds String[] @db.ObjectId
}

model Class {
  id                       String   @id @default(uuid()) @map("_id") @db.ObjectId
  name                     String
  currentClassOnTickets    Ticket[]
  interestedClassOnTickets Ticket[] @relation(name: "_InterestedClassToTicket", fields: [interestedClassOnTicketIds], references: [id])

  interestedClassOnTicketIds String[] @db.ObjectId
}

model Subject {
  id       String   @id @default(uuid()) @map("_id") @db.ObjectId
  name     String
  semester Int
  tickets  Ticket[] @relation(fields: [ticketIds], references: [id])

  ticketIds String[] @db.ObjectId
}
