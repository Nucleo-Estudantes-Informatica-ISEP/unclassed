# ==============================================
# Unclassed Environment Configuration
# ==============================================

# Database (REQUIRED)
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unclassed

# Application URLs (REQUIRED)
APP_BASE_URL=https://unclassed.example.com
NEXT_PUBLIC_APP_URL=https://unclassed.example.com

# Authentication & Security (REQUIRED)
AUTH_SECRET=replace_with_random_session_secret_at_least_32_chars
AUTH_ISSUER_URL=https://auth.example.com
AUTH_CLIENT_ID=replace_with_zitadel_client_id
AUTH_CLIENT_SECRET=replace_with_zitadel_client_secret
AUTH_SCOPES=openid email profile
AUTH_ROLE_CLAIM=urn:zitadel:iam:org:project:roles
AUTH_POST_LOGOUT_REDIRECT_URI=https://unclassed.example.com/
AUTH_TRUST_HOST=false

# Environment
NODE_ENV=production

# Cron Scheduler Configuration
CRON_SECRET=replace_with_random_cron_secret_at_least_32_chars
ENABLE_CRON_SCHEDULER=true
CRON_BATCH_MATCHING=*/5 * * * *
CRON_PROVISIONAL_CLEANUP=*/30 * * * *
CRON_HEALTH_CHECK=0 * * * *

# Email Service Configuration (OPTIONAL)
EMAIL_FROM=unclassed@nei-isep.org
EMAIL_HOST=mail.nei-isep.org
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=replace_with_email_username
EMAIL_PASS=replace_with_email_password

# Additional Next.js Configuration
NEXT_TELEMETRY_DISABLED=1
