{
  "name": "permutas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "node tests/run-integration.mjs",
    "test:e2e": "playwright test",
    "test:k6:smoke": "k6 run tests/k6/scenarios/smoke.js",
    "test:k6:load": "k6 run tests/k6/scenarios/load.js",
    "test:k6:stress": "k6 run tests/k6/scenarios/stress.js",
    "test:k6:spike": "k6 run tests/k6/scenarios/spike.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "sync": "pnpm schema:deploy",
    "schema:validate": "node prisma/validate-schema.mjs && node prisma/check-schema-manifest.mjs && node prisma/check-mongodb-indexes.mjs",
    "schema:audit": "node prisma/apply-mongodb-indexes.mjs --audit-only",
    "schema:deploy": "pnpm schema:validate && prisma db push --skip-generate && node prisma/apply-mongodb-indexes.mjs",
    "generate": "prisma generate",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} --transpile-only prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@sentry/nextjs": "^11.8.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.10.2",
    "cytoscape": "^3.34.4",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "sweetalert": "^2.1.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "eslint --max-warnings=0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-helpers": "^2.0.2",
    "eslint-plugin-prettier": "^5.5.7",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "jsonwebtoken": "^9.0.3",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "6.4.4",
    "vitest": "^3.2.7"
  }
}
