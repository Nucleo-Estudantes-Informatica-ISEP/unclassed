{
  "name": "permutas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --require ts-node/register/transpile-only src/**/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "sync": "prisma db push",
    "generate": "prisma generate",
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} --transpile-only prisma/seed.ts",
    "populate": "ts-node --transpile-only scripts/populate-test-data.ts",
    "test-cron": "ts-node --transpile-only scripts/test-cron.ts",
    "test-cron-system": "ts-node --transpile-only scripts/test-cron-system.ts",
    "postinstall": "prisma generate"
  },
